# 统一行尾：仓库内与检出后一律 LF，避免 Windows/Linux 交叉提交产生假改动。
* text=auto eol=lf

*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
*.patch text eol=lf
*.yml   text eol=lf

# 编译拼装产物：PR Diff 自动折叠，避免噪音淹没源码变更
client.js linguist-generated=true

# 二进制资源
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
