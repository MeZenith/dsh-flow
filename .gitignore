# dsh-flow standard ignore rules (replaces fragile whitelist)

# Dependencies & caches
node_modules/
.pnpm-store/
.npm/
.cache/

# Build & test artifacts
dist/
build/
out/
coverage/

# Runtime state, local workspace flow docs, logs & scratch files
.flow/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
*.tmp
*.bak

# Environment & secrets
.env
.env.*
*.local

# OS & editor clutter
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
