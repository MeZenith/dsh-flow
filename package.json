{
  "name": "dsh-flow",
  "version": "0.1.0",
  "type": "module",
  "description": "Flow 工作流与提示词管家：五大快捷模式、分层提示词注入、模式默认模型。",
  "icon": "./icon.svg",
  "license": "SEE LICENSE IN LICENSE",
  "author": "MeZenith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeZenith/dsh-flow.git"
  },
  "homepage": "https://github.com/MeZenith/dsh-flow#readme",
  "bugs": {
    "url": "https://github.com/MeZenith/dsh-flow/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "config.js",
    "modes.js",
    "mode-plan.js",
    "mode-projection.js",
    "prompt-bridge.js",
    "commands.js",
    "client.js",
    "cordis.patch.yml",
    "vendor",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "THIRD_PARTY_NOTES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
