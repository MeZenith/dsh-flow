{
  "name": "dsh-flow",
  "version": "0.6.1",
  "type": "module",
  "description": "Flow 工作流、提示词管家与直连飞书指挥官：五大模式、编号文档体系、连续报错熔断与多项目手机远程指挥。",
  "icon": "./icon.svg",
  "author": "MeZenith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeZenith/dsh-flow.git"
  },
  "homepage": "https://github.com/MeZenith/dsh-flow#readme",
  "bugs": {
    "url": "https://github.com/MeZenith/dsh-flow/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "build:client": "node scripts/build-client.mjs",
    "build:client:check": "node scripts/build-client.mjs --check",
    "manifest:sync": "node scripts/sync-manifest.mjs",
    "manifest:check": "node scripts/sync-manifest.mjs --check",
    "check": "node --check index.js && node --check client.js && npm run build:client:check && npm run manifest:check"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "prompts",
    "vendor",
    "locale",
    "cordis.patch.yml",
    "docs/DETAIL.md",
    "docs/flow-api-research.md",
    "icon.svg",
    "README.md",
    "README.en.md",
    "THIRD_PARTY_NOTES.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "license": "Apache-2.0"
}
